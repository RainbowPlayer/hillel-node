<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Список користувачів</title>
  <style>
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background: #f4f4f4; }
  </style>
</head>
<body>
  <h1>Користувачі</h1>
  <table>
    <thead>
      <tr>
        <th>Ім'я</th>
        <th>Вік</th>
        <th>Email</th>
      </tr>
    </thead>
    <tbody>
      <% if (users.length === 0) { %>
        <tr><td colspan="3">Немає користувачів</td></tr>
      <% } else { %>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.age %></td>
            <td><a href="mailto:<%= u.email %>"><%= u.email %></a></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</body>
</html>