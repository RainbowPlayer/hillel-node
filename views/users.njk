<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Користувачі</title>
  <style>
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #aaa; padding: 6px 10px; }
    th { background: #f0f0f0; }
  </style>
</head>
<body>
  <h1>Список користувачів</h1>
  <table>
    <thead>
      <tr>
        <th>Ім’я</th>
        <th>Вік</th>
        <th>Email</th>
      </tr>
    </thead>
    <tbody>
      {% for user in users %}
        <tr>
          <td>{{ user.name }}</td>
          <td>{{ user.age }}</td>
          <td><a href="mailto:{{ user.email }}">{{ user.email }}</a></td>
        </tr>
      {% else %}
        <tr>
          <td colspan="3">Немає користувачів</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
