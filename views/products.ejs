<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Список продуктів</title>
  <style>
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background: #f4f4f4; }
    .in-stock    { color: green; }
    .out-of-stock{ color: red;   }
  </style>
</head>
<body>
  <h1>Продукти</h1>
  <table>
    <thead>
      <tr>
        <th>Назва</th>
        <th>Ціна, грн</th>
        <th>Наявність</th>
      </tr>
    </thead>
    <tbody>
      <% if (products.length === 0) { %>
        <tr>
          <td colspan="3">Немає продуктів</td>
        </tr>
      <% } else { %>
        <% products.forEach(prod => { %>
          <tr>
            <td><%= prod.name %></td>
            <td><%= prod.price %></td>
            <td class="<%= prod.inStock ? 'in-stock' : 'out-of-stock' %>">
              <%= prod.inStock ? 'В наявності' : 'Немає в наявності' %>
            </td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</body>
</html>
